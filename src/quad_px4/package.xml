<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_px4</name>
  <version>0.1.0</version>
  <description>PX4 SITL backend for the FxTESO IBVS stack: state adapter, OFFBOARD setpoint
  bridge and the F450 airframe definition. The high-level observer and IBVS controller run
  unchanged in quad_control; PX4 owns attitude, rates and mixing.</description>
  <maintainer email="losfansdepalomino@proton.me">soni</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>tf2</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>quad_common</depend>

  <!-- sitl.launch.py composes the world and estimation layers from these. -->
  <exec_depend>quad_control</exec_depend>
  <exec_depend>quad_gz_sim</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
