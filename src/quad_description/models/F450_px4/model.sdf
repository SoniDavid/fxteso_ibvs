<?xml version='1.0'?>
<!-- F450 for plant:=px4: F450_base geometry plus the motor model PX4's allocator drives.
     Nothing in this workspace computes thrust or mixing here.

     Motor numbering is PX4 quad_x and F450_base already has the matching propeller
     handedness, so the mapping is a pass-through:

       0 rotor_front_right ccw | 1 rotor_rear_left  ccw
       2 rotor_front_left  cw  | 3 rotor_rear_right cw

     The link poses must agree with CA_ROTOR*_P{X,Y} in the 22100_gz_F450_px4 airframe.
     motorConstant is C_T fitted to T-Motor's bench table for the Navigator MN2212 V2.0 KV920
     on a 9545B - 0.2% off the x500 value this was forked from. momentConstant is still x500's:
     no C_D has been measured for this motor.
     maxRotVelocity is only a ceiling. The operating limit is SIM_GZ_EC_MAX, which sitl.launch.py
     derives from battery_cells; this must stay above it or the motor model clamps. -->
<sdf version='1.9'>
  <model name='F450_px4'>

    <include merge='true'>
      <uri>model://F450_base</uri>
    </include>

    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_front_right_joint</jointName>
      <linkName>rotor_front_right</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1200.0</maxRotVelocity>
      <motorConstant>8.566e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_rear_left_joint</jointName>
      <linkName>rotor_rear_left</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1200.0</maxRotVelocity>
      <motorConstant>8.566e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_front_left_joint</jointName>
      <linkName>rotor_front_left</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1200.0</maxRotVelocity>
      <motorConstant>8.566e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_rear_right_joint</jointName>
      <linkName>rotor_rear_right</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1200.0</maxRotVelocity>
      <motorConstant>8.566e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

  </model>
</sdf>
