<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_utils</name>
  <version>0.1.0</version>
  <description>Simulation bringup, the TF/marker broadcaster, Foxglove layouts and the bag topic list.</description>
  <maintainer email="losfansdepalomino@proton.me">SoniDavid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>quad_common</depend>

  <!-- The layers sim.launch.py composes -->
  <exec_depend>quad_description</exec_depend>
  <exec_depend>quad_gz_sim</exec_depend>
  <exec_depend>quad_control</exec_depend>

  <!-- rosbag:=true records to mcap; Foxglove Studio cannot open rosbag2's default .db3 -->
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <!-- Optional, pulled in by foxglove:=true -->
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
