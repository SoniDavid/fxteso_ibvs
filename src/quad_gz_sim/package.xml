<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_gz_sim</name>
  <version>0.1.0</version>
  <description>
    Simulation only: the world, the ros_gz bridge, both plant backends, the scenario
    generators, and the gz-sim plugin that applies the wrench inside the physics step.
    Nothing here exists on the real aircraft.
  </description>
  <maintainer email="losfansdepalomino@proton.me">SoniDavid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>quad_common</depend>

  <!-- gz_pose_broadcaster links gz-transport/gz-msgs directly; BodyWrenchSystem also
       needs gz-sim/gz-plugin. On Jazzy these come from ros_gz's vendor packages,
       not from a system Gazebo install. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <!-- Gazebo Harmonic bridge (ros-jazzy-ros-gz) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- bridge.yaml maps /clock -->
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- worlds/ibvs.sdf resolves model://F450 and model://aruco_target from here -->
  <exec_depend>quad_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
