<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_gz_sim</name>
  <version>0.1.0</version>
  <description>Simulation only: the world, the ros_gz bridge, the plant backends and the scenario generators.</description>
  <maintainer email="losfansdepalomino@proton.me">SoniDavid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>quad_common</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>

  <!-- gz libraries from ros_gz's vendor packages, not a system Gazebo. -->
  <depend>gz_transport_vendor</depend>
  <depend>gz_msgs_vendor</depend>
  <depend>gz_sim_vendor</depend>
  <depend>gz_plugin_vendor</depend>

  <!-- Gazebo Harmonic bridge (ros-jazzy-ros-gz) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- bridge.yaml maps /clock -->
  <exec_depend>rosgraph_msgs</exec_depend>
  <!-- hitl_bridge.py. gz.transport13/gz.msgs10 are python3-gz-transport13 and python3-gz-msgs10
       (OSRF apt, no rosdep key); pymavlink has no rosdep key either: pip install pymavlink. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- worlds/ibvs.sdf resolves model://F450 and model://aruco_target from here -->
  <exec_depend>quad_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
