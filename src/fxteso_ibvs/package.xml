<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fxteso_ibvs</name>
  <version>0.1.0</version>
  <description>
    Image-based visual servoing of a quadrotor with a fixed-time extended state observer
    and an adaptive-gain sliding-mode controller. ROS 2 Humble / Gazebo Harmonic port of
    the ROS 1 fxteso_asgibvs package; the control law and the plant model are unchanged,
    only the simulation and middleware layers were rewritten.
  </description>
  <maintainer email="losfansdepalomino@proton.me">SoniDavid</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>tf2</depend>
  <depend>eigen</depend>

  <!-- tf_broadcaster: TF, trajectory trails and markers for the Foxglove 3D panel -->
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- Gazebo Harmonic bridge (ros-humble-ros-gzharmonic) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <!-- Optional, pulled in by foxglove:=true -->
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
