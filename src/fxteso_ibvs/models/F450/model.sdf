<?xml version='1.0'?>
<!-- DJI F450 quadrotor. Visual only: uav_dynamics.cpp owns the plant, and nothing here has
     collision geometry. The airframe is built inside frame "body" (the model frame rolled
     by pi, applied by gz_pose_broadcaster), so everything below is FLU. Meshes are in mm.
     Frames, meshes and rotor conventions: documentation.md section 5. -->
<sdf version='1.9'>
  <model name='F450'>

    <!-- Rolled pi so that the broadcaster's own pi roll cancels and the quad flies upright. -->
    <frame name='body'>
      <pose>0 0 0 3.141592 0 0</pose>
    </frame>

    <!-- ================= airframe: plates + arms + motors ====================== -->
    <link name='base_link'>
      <pose relative_to='body'>0 0 0 0 0 0</pose>
      <self_collide>0</self_collide>

      <!-- Mass/inertia carried over from the placeholder so the model still reads as a
           2 kg F450; the plant integrates its own copy of these numbers. -->
      <inertial>
        <mass>1.852</mass>
        <inertia>
          <ixx>0.0411</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0478</iyy>
          <iyz>0</iyz>
          <izz>0.0599</izz>
        </inertia>
      </inertial>

      <visual name='base_plate'>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/base_plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <visual name='top_plate'>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/top_plate.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Front arms red, rear white (stock livery): the only heading cue in the 3D view.
           Mesh is the front right arm; +90 deg of yaw walks it round the other three. -->
      <visual name='arm_front_right'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/arm.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.02 0.02 1</ambient>
          <diffuse>0.75 0.04 0.04 1</diffuse>
          <specular>0.2 0.1 0.1 1</specular>
        </material>
      </visual>

      <visual name='arm_front_left'>
        <pose>0 0 0 0 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/arm.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.02 0.02 1</ambient>
          <diffuse>0.75 0.04 0.04 1</diffuse>
          <specular>0.2 0.1 0.1 1</specular>
        </material>
      </visual>

      <visual name='arm_rear_left'>
        <pose>0 0 0 0 0 3.1415927</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/arm.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <visual name='arm_rear_right'>
        <pose>0 0 0 0 0 -1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/arm.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Motor mesh is authored at the front left boom. -->
      <visual name='motor_front_left'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.42 0.43 0.46 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <visual name='motor_rear_left'>
        <pose>0 0 0 0 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.42 0.43 0.46 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <visual name='motor_rear_right'>
        <pose>0 0 0 0 0 3.1415927</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.42 0.43 0.46 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <visual name='motor_front_right'>
        <pose>0 0 0 0 0 -1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/motor.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.42 0.43 0.46 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>
      </visual>

      <!-- Camera at the model origin, looking along body -z. The plant treats quad
           position as camera position, so this must stay at 0 0 0. Nothing occludes it. -->
      <sensor name='camera1' type='camera'>
        <pose>0 0 0 0 1.570796 0</pose>
        <topic>quad/camera/image_raw</topic>
        <camera name="head">
          <horizontal_fov>1.085595</horizontal_fov>
          <image>
            <!-- Twice the ROS 1 resolution; required to decode the markers from the
                 paper's -4 m start. pixel_size in image_features.cpp is halved to match. -->
            <width>820</width>
            <height>616</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- Sim-time rate, matching image_features' own 50 Hz loop. Do not lower it; to
             slow the simulation change real_time_factor in worlds/ibvs.sdf instead. -->
        <update_rate>50</update_rate>
        <visualize>1</visualize>
      </sensor>
    </link>

    <!-- ================= rotors ================================================ -->
    <!-- One link per propeller. Visual offset is minus the hub position (the STL is in
         assembly coordinates); yaw is the k*90 deg off the front left blade. -->

    <link name='rotor_front_left'>
      <pose relative_to='body'>0.158911 0.158901 0.079647 0 0 0</pose>
      <inertial>
        <mass>0.036964</mass>
        <inertia>
          <ixx>0.0000925</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000925</iyy><iyz>0</iyz>
          <izz>0.000185</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <pose>-0.158911 -0.158901 -0.079647 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/propeller_cw.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name='rotor_rear_left'>
      <pose relative_to='body'>-0.158901 0.158911 0.079647 0 0 0</pose>
      <inertial>
        <mass>0.036964</mass>
        <inertia>
          <ixx>0.0000925</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000925</iyy><iyz>0</iyz>
          <izz>0.000185</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <pose>0.158901 -0.158911 -0.079647 0 0 1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/propeller_ccw.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name='rotor_rear_right'>
      <pose relative_to='body'>-0.158911 -0.158901 0.079647 0 0 0</pose>
      <inertial>
        <mass>0.036964</mass>
        <inertia>
          <ixx>0.0000925</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000925</iyy><iyz>0</iyz>
          <izz>0.000185</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <pose>0.158911 0.158901 -0.079647 0 0 3.1415927</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/propeller_cw.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <link name='rotor_front_right'>
      <pose relative_to='body'>0.158901 -0.158911 0.079647 0 0 0</pose>
      <inertial>
        <mass>0.036964</mass>
        <inertia>
          <ixx>0.0000925</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0000925</iyy><iyz>0</iyz>
          <izz>0.000185</izz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <pose>-0.158901 0.158911 -0.079647 0 0 -1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://F450/meshes/propeller_ccw.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>

    <!-- The URDF's "continuous" joints; SDF has no such type, so revolute with limits
         wide enough never to be reached. Axis +z up, positive command = CCW from above. -->
    <joint name='rotor_front_left_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_front_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name='rotor_rear_left_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_rear_left</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name='rotor_rear_right_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_rear_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <joint name='rotor_front_right_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_front_right</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0</damping><friction>0</friction></dynamics>
      </axis>
    </joint>

    <!-- Cosmetic rotor spin; no aerodynamics anywhere. QuadX signs, repeated in
         gz_pose_broadcaster - change one and you must change the other.
         Speeds are ~10x slow on purpose, or the blur aliases. See documentation.md 5. -->
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_front_left_joint</joint_name>
      <initial_velocity>-60.0</initial_velocity>
      <topic>/model/F450/joint/rotor_front_left_joint/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_rear_right_joint</joint_name>
      <initial_velocity>-60.0</initial_velocity>
      <topic>/model/F450/joint/rotor_rear_right_joint/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_front_right_joint</joint_name>
      <initial_velocity>60.0</initial_velocity>
      <topic>/model/F450/joint/rotor_front_right_joint/cmd_vel</topic>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_rear_left_joint</joint_name>
      <initial_velocity>60.0</initial_velocity>
      <topic>/model/F450/joint/rotor_rear_left_joint/cmd_vel</topic>
    </plugin>

    <static>0</static>
    <allow_auto_disable>0</allow_auto_disable>
  </model>
</sdf>
